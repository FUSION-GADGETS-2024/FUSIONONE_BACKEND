# dependencies
node_modules/
node/
yarn/*
.pnp.*

# build output
dist/
.next/
out/
build/
*.tsbuildinfo

# runtime data (Baileys auth state, etc.)
data/
upload/
uploads/

# env & secrets
# .env is platform-managed (rewritten by /start.sh); .env.local is
# force-added to the sandbox git for restart persistence
.env
.env.*
!.env.example

# vite
.vite/

# logs
*.log
dev.out.log
dev.log
server.log

# testing
coverage/

# misc
.DS_Store
.pnp.*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

local-*
.claude
.z-ai-config
# root-level scratch dir only (src/test/ is real source)
/test
prompt

# nested backend repo — track backend source, not its own git metadata
backend/.git/

# tool-results
tool-results/

# --- sandbox additions (platform-provided trees / runtime artifacts) ---
# skill tree re-extracted from /home/official_skills on every boot
skills/
/skills/
# dev-server pid files (regenerated by .zscripts/dev.sh)
.zscripts/*.pid
.zscripts/*.log

# clawhub CLI local state (skill installs)
.clawhub/

# local sandbox credentials - contains live secrets, never commit
DEV_CREDENTIALS.md

# build artifacts / generated reports
.wrangler/
# generated report downloads (artifacts only — download/README.md is tracked)
download/*
!download/README.md
!download/spec-implementation.txt