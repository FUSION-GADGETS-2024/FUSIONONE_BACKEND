# FUSIONONE — Vite SPA environment template
#
# These are the ONLY browser-safe values the frontend may expose. Everything
# below is bundled into the public JavaScript — NEVER add a privileged secret
# here (no SUPABASE_SECRET_KEY / service-role key, no PING_TOKEN, no backend
# API token). Backend-only secrets live in backend/.env (see backend/.env.example).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable key>

# FUSION ONE backend — the browser calls the hosted backend DIRECTLY
# (cross-origin, Bearer JWT per request). No gateway or proxy sits in front
# of the SPA. Set the absolute backend origin. It must be listed in the
# backend's CLIENT_ORIGIN.
VITE_FUSIONONE_BACKEND_BASE=https://backend.example.com

# =============================================================================
# BACKEND — server-side only
# =============================================================================
# The VITE_* vars above are the ONLY values the browser may see. Everything in
# this section is server-side: put it in backend/.env (or the host's dashboard).
# NEVER prefix any of these with VITE_ and never commit a filled-in copy.
# =============================================================================

# FUSION ONE Backend — environment template
# Copy to .env (or set in the host's dashboard, e.g. Render) and fill in real
# values. NEVER commit a real secret.

NODE_ENV=production

# HTTP server bind
PORT=3000
HOST=0.0.0.0

# --- Supabase (user-identity access model) ---
# All DATA access runs under the REQUESTING USER's JWT + this publishable
# key + RLS. The optional secret key is used ONLY by owner-controlled Auth
# administration (user invitations / user listing) — server-side only.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable key>
SUPABASE_SECRET_KEY=<secret key — server-only, optional; empty disables user management>

# Public origin of the frontend app (invitation / password-reset email
# redirect target). Must be listed in the Supabase project's redirect URLs.
APP_BASE_URL=https://<frontend-domain>

# --- CORS: allowed browser origins (comma-separated) ---
# Production should list the exact SPA origins (e.g. the Cloudflare Pages
# domain). "*" is for dev sandboxes only.
CLIENT_ORIGIN=https://<frontend-domain>

# --- Cron/wakeup probe (GET /ping) ---
# Dedicated secret checked via the X-Ping-Token REQUEST HEADER (never a URL
# query parameter, never exposed to the browser/frontend).
# Generate e.g.: openssl rand -hex 32
# Unset/empty = /ping always returns 401 (fail closed).
PING_TOKEN=

# --- WhatsApp / runtime tuning ---
LOG_LEVEL=info
EXPECTED_WHATSAPP_JID=
RECONNECT_BASE_MS=1000
RECONNECT_MAX_MS=60000
SEND_TIMEOUT_MS=30000
SEND_MAX_RETRIES=3
SEND_RETRY_BASE_MS=2000
MAX_REQUEST_BODY_BYTES=10485760

# --- Redis session backup (SECONDARY persistence) ---
# Empty REDIS_URL = backup layer disabled (local filesystem only).
# When set, the WhatsApp auth directory is backed up (AES-256-GCM encrypted,
# scrypt key derivation) to Redis and restored ONLY when the local session
# is missing/unusable. Format: redis://[username]:[password]@[host]:[port]
REDIS_URL=
# Server-side encryption secret for the backup payload (REQUIRED when
# REDIS_URL is set; at least 16 characters). Generate e.g.:
#   openssl rand -hex 32
# NEVER expose this key to any frontend and never log it.
WHATSAPP_BACKUP_ENCRYPTION_KEY=

# --- WhatsApp runtime lifecycle ---
# When the LAST authenticated frontend client disconnects and no other
# runtime demand exists (no active send, startup, or reconnect), the Baileys
# runtime keeps running for this grace period before the intentional stop
# (session preserved). A client returning within the grace cancels it.
# Default: 300000 (5 minutes).
WHATSAPP_CLIENT_DISCONNECT_GRACE_MS=300000
# Bounded wait for a runtime wake to reach CONNECTED.
WHATSAPP_WAKE_TIMEOUT_MS=20000

# --- Durable message scheduler ---
# Periodic due-job scan interval (ms). Min 5000. Default: 15000.
MESSAGE_POLL_INTERVAL_MS=15000
# Claim lease (ms): how long a claimed-but-unfinished job is protected
# before recovery makes it retryable again. Must exceed worst-case job
# execution (WhatsApp send timeout x retries + PDF + thumbnail). Min 30000.
# Default: 300000.
MESSAGE_JOB_LEASE_MS=300000

# --- Party Documents (private Cloudflare R2 + application-level encryption) ---
# Document storage is BACKEND-ONLY: the browser never receives R2
# credentials, presigned or public object URLs, or encryption keys —
# preview/download stream decrypted plaintext through the authenticated
# /api/parties/:partyId/documents routes.
# Unset/empty = the party-document endpoints fail closed (503).
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET=fusionone-documents
# Master key for envelope encryption (AES-256-GCM, per-document DEKs).
# base64 of exactly 32 bytes. Generate e.g.:
#   openssl rand -base64 32
# NEVER expose this key to any frontend and never log it.
DOCUMENTS_MASTER_KEY=<base64-32-byte-key>
# Maximum accepted document upload size in bytes (default 10485760 = 10 MB).
MAX_DOCUMENT_FILE_BYTES=10485760
