# WhatsApp Invoice Backend — environment template
# Copy to .env (or set in the host's dashboard, e.g. Render) and fill in real
# values. NEVER commit a real secret.

NODE_ENV=production

# HTTP server bind
PORT=3000
HOST=0.0.0.0

# --- Supabase (user-identity access model) ---
# All data access runs under the REQUESTING USER's JWT + this publishable
# key + RLS. There is NO secret/service key in this service.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable key>

# --- CORS: allowed browser origins (comma-separated) ---
# Production should list the exact SPA origins (e.g. the Cloudflare Pages
# domain). "*" is for dev sandboxes only.
CLIENT_ORIGIN=https://<frontend-domain>

# --- Cron/wakeup probe (GET /ping) ---
# Dedicated secret checked via the X-Ping-Token REQUEST HEADER (never a URL
# query parameter, never exposed to the browser/frontend).
# Generate e.g.: openssl rand -hex 32
# Unset/empty = /ping always returns 401 (fail closed).
PING_TOKEN=

# --- WhatsApp / runtime tuning ---
LOG_LEVEL=info
EXPECTED_WHATSAPP_JID=
RECONNECT_BASE_MS=1000
RECONNECT_MAX_MS=60000
SEND_TIMEOUT_MS=30000
SEND_MAX_RETRIES=3
SEND_RETRY_BASE_MS=2000
MAX_REQUEST_BODY_BYTES=10485760
SHUTDOWN_TIMEOUT_MS=15000

# --- Redis session backup (SECONDARY persistence) ---
# Empty REDIS_URL = backup layer disabled (local filesystem only).
# When set, the WhatsApp auth directory is backed up (AES-256-GCM encrypted,
# scrypt key derivation) to Redis and restored ONLY when the local session
# is missing/unusable. Format: redis://[username]:[password]@[host]:[port]
REDIS_URL=
# Server-side encryption secret for the backup payload (REQUIRED when
# REDIS_URL is set; at least 16 characters). Generate e.g.:
#   openssl rand -hex 32
# NEVER expose this key to any frontend and never log it.
WHATSAPP_BACKUP_ENCRYPTION_KEY=

# --- WhatsApp runtime lifecycle ---
# When the LAST authenticated frontend client disconnects and no other
# runtime demand exists (no active send, startup, or reconnect), the Baileys
# runtime keeps running for this grace period before the intentional stop
# (session preserved). A client returning within the grace cancels it.
# Default: 300000 (5 minutes).
WHATSAPP_CLIENT_DISCONNECT_GRACE_MS=300000
# Bounded wait for a runtime wake to reach CONNECTED.
WHATSAPP_WAKE_TIMEOUT_MS=20000
